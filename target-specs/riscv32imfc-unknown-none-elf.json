{
  "arch": "riscv32",
  "cpu": "generic-rv32",
  "data-layout": "e-m:e-p:32:32-i64:64-n32-S128",
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "features": "+m,+f,+c,+zicsr,-a,-d,-e,-zicsr,-zifencei",
  "is-builtin": false,
  "linker": "rust-lld",
  "linker-flavor": "ld.lld",
  "llvm-target": "riscv32-unknown-none-elf",
  "max-atomic-width": 0,
  "os": "none",
  "panic-strategy": "abort",
  "relocation-model": "static",
  "target-pointer-width": "32",
  "vendor": "hisilicon",
  "pre-link-args": {
    "ld.lld": ["--gc-sections", "--defsym=__ram_size=0xA0000"]
  },
  "post-link-args": {
    "ld.lld": ["--no-relax"]
  }
}
